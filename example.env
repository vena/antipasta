# ====================================
# AntiPasta AI Detection Configuration
# ====================================

# --- Core Engine ---
# "yolov11" for the modern, recommended model.
# "obico" for the Obico-Server model.
ML_ENGINE=yolov11

# Set your timezone to ensure image timestamps are localized (e.g. America/New_York)
TZ=America/New_York

# --- Logging ---
# Valid levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Networking ---
# The internal Flask server runs on 8080.
# CONTROLLER_PORT defines the publicly accessible port on your host.
CONTROLLER_PORT=8080

# The base URL used by external services (Home Assistant, Mobile App) to reach the controller.
# This is used to generate direct links to failure images in MQTT payloads.
CONTROLLER_EXTERNAL_URL="http://<YOUR_IP_ADDRESS>:${CONTROLLER_PORT}"

# --- Printer Credentials ---
PRINTER_IP=192.168.1.55
PRINTER_ACCESS_CODE=<YOUR_PRINTER_ACCESS_CODE>
PRINTER_SERIAL=<YOUR_PRINTER_SERIAL_NUMBER>

# --- Stream Configuration ---
# "chamber_image" for Bambu P1/A1 proprietary protocol.
# "rtsp" for standard RTSP/RTSPS streams.
STREAM_TYPE=chamber_image

# If true, establishes a persistent background connection to the camera stream.
# WARNING: This will permanently consume one of your printer/camera's connection slots,
# but drastically reduces latency for dashboards and AI inference.
STREAM_PERSISTENT=False

# If using standard RTSP/RTSPS streams (e.g. for the X1 or P2S):
# RTSP_URL="rtsps://bblp:${PRINTER_ACCESS_CODE}@${PRINTER_IP}:322/streaming/live/1"

# --- Security & TLS ---
# By default, AntiPasta bypasses TLS validation because local network cameras
# and 3D printers often use self-signed certificates.
STRICT_TLS=False

# If you have a custom CA certificate (e.g. for Bambu Lab or a local Nginx reverse proxy),
# mount it into the logic container and provide the path here.
# CUSTOM_CA_CERT_PATH="/app/custom_ca.crt"

# --- MQTT Configuration ---
MQTT_HOST=mqtt.home.yourdomain.net
MQTT_USER=mqtt-user
MQTT_PASSWORD="mqtt-password"

# The Home Assistant Discovery Prefix (Default: homeassistant)
MQTT_DISCOVERY_PREFIX=homeassistant

# The topic the logic controller subscribes to for the printer's state.
# Analysis only occurs when the payload received matches the "printing" state.
# NOTE: All MQTT topics are normalized to lower case internally.
MQTT_PRINTER_STATUS_TOPIC="homeassistant/sensor/p1s_${PRINTER_SERIAL}_current_stage/state"

# --- Printer State Matching ---
# Define what incoming MQTT payloads map to an "Active Print" vs a "Paused" state.
# These values are treated as Python regular expressions, so they are case-insensitive
# and can match multiple variations of states (e.g. "pause.*" catches "pause", "paused", etc.)
# If it is just a normal string like "printing", it will match exactly.
MQTT_PRINTER_STATE_PRINTING="printing"
MQTT_PRINTER_STATE_PAUSED="pause.*"

# --- AI Settings ---
# Only change MODEL_ENDPOINT if you wish to use a different, Obico
# ml_api-compatible inference API than those provided, or if you wish
# to alter the container networking settings.
MODEL_ENDPOINT=http://antipasta-ml:3333/p/

# Seconds between AI analysis cycles.
FRAME_INTERVAL=5

# AI confidence level (0.0 to 1.0) required to count a frame as a suspected failure or artifact.
CONFIDENCE_THRESHOLD=0.4

# Space-separated list of detection classes that represent a critical, print-ruining failure.
# Any detection NOT in this list (like 'stringing' or 'zits') is treated as a non-critical artifact.
# We include 'failure' by default as it's the only type emitted by the Obico model.
CRITICAL_FAILURES="spaghetti failure"

# Consecutive critical frames required before sending a "Warning" alert (approaching pause).
WARNING_THRESHOLD=3

# Consecutive critical frames required before sending a "Pause" command.
PAUSE_THRESHOLD=6

# Consecutive artifact frames (e.g., stringing) required before sending a "Concern" alert.
CONCERN_THRESHOLD=3

# Exclusion zones hide false positives (like textured build plate handles).
# Defined as a JSON list of relative coordinate lists: [[x1, y1, x2, y2]]
# where 0.0 is top/left and 1.0 is bottom/right.
# Example: "[[0.85, 0.0, 1.0, 1.0]]" masks the far right 15% of the frame.
# NOTE for Bed-Slingers: The bed moves! Limit exclusion zones to static background objects.
EXCLUSION_ZONES="[]"

# --- Storage & Retention ---
# The directory inside the logic container where failure frames are archived.
FAILURES_DIR="/failures"

# The directory on the host where machine learning model weights are cached.
# This prevents re-downloading models every time the Docker containers are updated.
MODEL_CACHE_DIR="./tmp/model_cache"

# The directory on the host where the dynamic ML backend API is scaffolded before build.
ML_API_BUILD_DIR="./tmp/ml_api"

# Retention Policy: The system will only KEEP the last N images newer than X days.
# Cleanup is performed at the start of every new print job.
FAILURE_RETENTION_DAYS=7
FAILURE_RETENTION_COUNT=20